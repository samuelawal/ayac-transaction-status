# Copy to .env and fill in. The server reads these at startup and signs itself in;
# the browser never sees them.
#
#   cp .env.example .env

# sandbox -> https://sandbox.monnify.com   |   live -> https://api.monnify.com
MONNIFY_ENV=sandbox

MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=

# Port for the API proxy (also serves the built app).
PORT=4000
